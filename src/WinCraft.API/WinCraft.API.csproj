<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinCraft.Application\WinCraft.Application.csproj" />
    <ProjectReference Include="..\WinCraft.Infrastructure\WinCraft.Infrastructure.csproj" />
    <ProjectReference Include="..\WinCraft.Shared\WinCraft.Shared.csproj" />
  </ItemGroup>
</Project>
